{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anandh8x/arcdoctor/cases/schema.json",
  "title": "Arc Doctor reviewed diagnostic case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "summary",
    "network",
    "diagnosticCodes",
    "evidence",
    "resolution",
    "source",
    "compatibility",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^arc-case-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chainId"],
      "properties": {
        "name": {
          "const": "Arc Testnet"
        },
        "chainId": {
          "const": 5042002
        }
      }
    },
    "diagnosticCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ARC-[A-Z]+-[0-9]{3}$"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explanation", "checks"],
      "properties": {
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": ["public-transaction", "public-repository", "reproduction"]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arcDoctor", "ruleset"],
      "properties": {
        "arcDoctor": {
          "type": "string",
          "minLength": 1
        },
        "ruleset": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewedAt"],
      "properties": {
        "status": {
          "enum": ["submitted", "reviewed", "superseded"]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
